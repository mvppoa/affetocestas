# As variáveis do banco usam o prefixo affetocestas_ criado pela integração Neon na Vercel.

# Banco Postgres: conexão do site e conexão direta para as migrações.
# Localmente, as duas podem ser iguais.
affetocestas_POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/afetto"
affetocestas_POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/afetto"

# Painel de admin
ADMIN_PASSWORD="troque-esta-senha"
# Pelo menos 32 caracteres aleatórios. Gere com: openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# Envio de fotos (Vercel Blob). Sem ele, o admin aceita só links de fotos.
BLOB_READ_WRITE_TOKEN=""

# Stripe (pagamentos). Use as chaves de TESTE (sk_test_...) até a loja estar pronta.
# Painel do Stripe > Desenvolvedores > Chaves de API
STRIPE_SECRET_KEY=""
# Segredo do webhook (whsec_...). Veja "Pagamentos com Stripe" no README.
STRIPE_WEBHOOK_SECRET=""
# Formas de pagamento no Checkout, separadas por vírgula. Pix precisa estar ativado no painel do Stripe.
STRIPE_PAYMENT_METHODS="card,pix"
# Endereço público do site (usado nos links de volta do pagamento). Opcional.
NEXT_PUBLIC_SITE_URL=""
