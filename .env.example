# Todas as variáveis usam o prefixo affetocestas_ (o mesmo da integração Neon na Vercel).

# Banco Postgres: conexão do site e conexão direta para as migrações.
# Localmente, as duas podem ser iguais.
affetocestas_POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/afetto"
affetocestas_POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/afetto"

# Painel de admin
affetocestas_ADMIN_PASSWORD="troque-esta-senha"
# Pelo menos 32 caracteres aleatórios. Gere com: openssl rand -base64 32
affetocestas_ADMIN_SESSION_SECRET=""

# Envio de fotos (Vercel Blob). Sem ele, o admin aceita só links de fotos.
affetocestas_BLOB_READ_WRITE_TOKEN=""
