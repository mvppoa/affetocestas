model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  /// Cor de destaque nos cartões (hex, ex.: #c8745a)
  color       String    @default("#b5835a")
  emoji       String    @default("🎁")
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  description    String     @default("")
  /// Preço em centavos (R$ 189,90 = 18990)
  priceCents     Int
  /// Preço "de" riscado, em centavos (opcional)
  compareAtCents Int?
  /// Itens que acompanham a cesta ou tábua
  items          String[]
  /// URLs das fotos; a primeira é a capa
  images         String[]
  /// Selos exibidos no produto, ex.: "Pronta entrega", "Mais vendido"
  badges         String[]
  stock          Int        @default(0)
  active         Boolean    @default(true)
  featured       Boolean    @default(false)
  categories     Category[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([active, featured])
}
